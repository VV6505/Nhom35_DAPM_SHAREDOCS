@model HeThong_User.Models.BaoCaoViPham

@{
    ViewData["Title"] = "Báo cáo vi phạm";
}

<div class="main-content py-5" style="background: #f4f4f4; min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-lg" style="border-radius: 12px; overflow: hidden;">
                    @* Header màu đỏ đặc trưng *@
                    <div class="card-header border-0 py-3" style="background-color: #d32f2f;">
                        <h5 class="text-white fw-bold mb-0 text-uppercase text-center">Báo cáo vi phạm</h5>
                    </div>
                    
                    <div class="card-body p-4 bg-white">
                        <p class="text-secondary small mb-4">Bạn đang báo cáo tài liệu: <strong class="text-dark">@ViewBag.TenTaiLieu</strong></p>

                        <form asp-action="Report" method="post">
                            <input type="hidden" asp-for="MaTaiLieu" value="@ViewBag.MaTaiLieu" />

                            <div class="mb-3">
                                <label class="form-label fw-bold small">Lý do vi phạm</label>
                                <select asp-for="LyDo" id="LyDoSelect" class="form-select py-2 border">
                                    <option value="">-- Chọn lý do --</option>
                                    <option value="Tài liệu sai kiến thức">Tài liệu sai kiến thức</option>
                                    <option value="Vi phạm bản quyền">Vi phạm bản quyền</option>
                                    <option value="Nội dung nhạy cảm">Nội dung nhạy cảm</option>
                                    <option value="Lỗi file, không mở được">Lỗi file, không mở được</option>
                                    <option value="TuYeuCauGo">Khác (Tác giả yêu cầu gỡ bài khẩn cấp)</option>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold small">Mô tả chi tiết</label>
                                @* Sửa từ MoTa thành MoTaChiTiet *@
                                <textarea asp-for="MoTaChiTiet" id="MoTaChiTiet" class="form-control border" rows="5" placeholder="Cung cấp thêm thông tin để Admin xử lý nhanh hơn..."></textarea>
                                <span id="error-message" class="text-danger small mt-1 d-block" style="display: none;"></span>
                            </div>

                            <button type="submit" class="btn btn-danger w-100 py-2 fw-bold mb-3" style="background-color: #d32f2f; border: none;">
                                Gửi báo cáo
                            </button>
                            
                            <div class="text-center">
                                <a href="javascript:history.back()" class="text-decoration-none small text-muted">Hủy bỏ</a>
                            </div>
                        </form>

                        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
                        <script>
                            $(document).ready(function () {
                                $('form').on('submit', function (e) {
                                    var selectedReason = $('#LyDoSelect').val();
                                    var description = $('#MoTaChiTiet').val().trim();
                                    var errorSpan = $('#error-message');

                                    // Reset thông báo lỗi
                                    errorSpan.hide().text('');

                                    if (selectedReason === 'TuYeuCauGo') {
                                        if (description === '') {
                                            e.preventDefault(); // Chặn hành động submit form
                                            errorSpan.text('Vui lòng nhập rõ lý do và thông tin để tác giả yêu cầu gỡ bài khẩn cấp.').show();
                                            $('#MoTaChiTiet').focus();
                                            return false;
                                        }
                                    }
                                });
                            });
                        </script>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>