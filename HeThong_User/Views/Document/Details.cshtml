@model HeThong_User.Models.TaiLieu

@{
    ViewData["Title"] = Model.TieuDe + " - Chi tiết tài liệu";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="main-content py-4">
    <div class="container-fluid px-4">
        <div class="page-head mb-4 text-start">
            <h1 class="fw-bold mb-1">Chi tiết tài liệu</h1>
            <p class="text-muted small">
                Môn: @(Model.MaMonHocNavigation?.TenMonHoc ?? "N/A") 
                <i class="fa-solid fa-chevron-right mx-1"></i> Khoa: @ViewBag.TenKhoa
            </p>
        </div>

        <div class="row">
            <div class="col-lg-8 col-md-12">
                <div class="card shadow-sm border-0 mb-4 p-4" style="border-radius: 12px;">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
                        <span class="badge bg-danger rounded-pill text-uppercase p-2">@Model.LoaiFile</span>
                        @{
                            var trangThai = Model.TrangThaiDuyet ?? "Chờ duyệt";
                            var badgeColor = trangThai == "Đã duyệt" ? "success" : (trangThai == "Từ chối" ? "danger" : "warning");
                            var badgeIcon  = trangThai == "Đã duyệt" ? "✅" : (trangThai == "Từ chối" ? "❌" : "⏳");
                        }
                        <span class="badge bg-@badgeColor rounded-pill p-2">@badgeIcon @trangThai</span>
                    </div>
                    <h2 class="fw-bold mb-4">@Model.TieuDe</h2>

                    <div class="text-muted mb-4">
                        @{
                            string baseMoTa = Model.MoTa ?? "";
                            string aiJson = "";
                            if (baseMoTa.Contains("--- AI EVALUATION ---"))
                            {
                                var parts = baseMoTa.Split(new[] { "--- AI EVALUATION ---" }, StringSplitOptions.None);
                                baseMoTa = parts[0].Trim();
                                aiJson = parts.Length > 1 ? parts[1].Trim() : "";
                            }
                        }
                        <p style="white-space: pre-line;">@baseMoTa</p>

                        @if (!string.IsNullOrEmpty(aiJson))
                        {
                            // Chỉ hiển thị cho chủ sở hữu tài liệu
                            var currentMaND = Context.Session.GetString("MaSinhVien") ?? Context.Session.GetString("MaGiangVien");
                            bool isOwner = Model.MaNguoiDang == currentMaND;

                            if (isOwner)
                            {
                                try
                                {
                                    var eval = System.Text.Json.JsonSerializer.Deserialize<HeThong_User.Services.RarenessEvaluation>(aiJson);
                                    if (eval != null)
                                    {
                                        <div class="ai-eval-box mt-4 p-4" style="border-radius: 16px; background: linear-gradient(135deg, #f0f7ff 0%, #e0efff 100%); border: 1px solid #bfdbfe; box-shadow: 0 4px 15px rgba(37, 99, 235, 0.1);">
                                            <div class="d-flex justify-content-between align-items-center mb-4">
                                                <h6 class="fw-bold text-primary mb-0" style="letter-spacing: 0.5px;">
                                                    <i class="fa-solid fa-microchip me-2"></i> PHÂN TÍCH GIÁ TRỊ TÀI LIỆU (AI)
                                                </h6>
                                                <span class="badge @(eval.Evaluation.Final_Rareness_Score >= 8.5 ? "bg-danger shadow-danger" : (eval.Evaluation.Final_Rareness_Score >= 6.0 ? "bg-primary shadow-primary" : "bg-secondary")) rounded-pill px-3 py-2 text-uppercase" style="font-size: 11px;">
                                                    @eval.Classification
                                                </span>
                                            </div>
                                            <div class="row g-4">
                                                <div class="col-6 col-md-3 text-center border-end">
                                                    <div class="text-primary mb-1" style="font-size: 18px;"><i class="fa-solid fa-file-contract"></i></div>
                                                    <div class="fw-bold" style="font-size: 16px;">@eval.Evaluation.S1_ContentType_Score/10</div>
                                                    <div class="small text-muted mt-1" style="font-size: 11px; line-height: 1.2; font-weight: 600;">Tính chuyên sâu & Thể loại</div>
                                                    @if (eval.Reasoning != null) {
                                                        <div class="mt-2 text-muted italic" style="font-size: 10px; line-height: 1.3;"><i>@eval.Reasoning.S1_Reason</i></div>
                                                    }
                                                </div>
                                                <div class="col-6 col-md-3 text-center border-md-end">
                                                    <div class="text-primary mb-1" style="font-size: 18px;"><i class="fa-solid fa-signature"></i></div>
                                                    <div class="fw-bold" style="font-size: 16px;">@eval.Evaluation.S2_Authority_Score/10</div>
                                                    <div class="small text-muted mt-1" style="font-size: 11px; line-height: 1.2; font-weight: 600;">Uy tín NXB & Tác quyền</div>
                                                    @if (eval.Reasoning != null) {
                                                        <div class="mt-2 text-muted italic" style="font-size: 10px; line-height: 1.3;"><i>@eval.Reasoning.S2_Reason</i></div>
                                                    }
                                                </div>
                                                <div class="col-6 col-md-3 text-center border-end">
                                                    <div class="text-primary mb-1" style="font-size: 18px;"><i class="fa-solid fa-clock-rotate-left"></i></div>
                                                    <div class="fw-bold" style="font-size: 16px;">@eval.Evaluation.S3_YearDistance_Score/10</div>
                                                    <div class="small text-muted mt-1" style="font-size: 11px; line-height: 1.2; font-weight: 600;">Giá trị thời gian (Năm XB)</div>
                                                    @if (eval.Reasoning != null) {
                                                        <div class="mt-2 text-muted italic" style="font-size: 10px; line-height: 1.3;"><i>@eval.Reasoning.S3_Reason</i></div>
                                                    }
                                                </div>
                                                <div class="col-6 col-md-3 text-center">
                                                    <div class="text-primary mb-1" style="font-size: 18px;"><i class="fa-solid fa-gem"></i></div>
                                                    <div class="fw-bold" style="font-size: 16px;">@eval.Evaluation.S4_PointsRequired_Score/10</div>
                                                    <div class="small text-muted mt-1" style="font-size: 11px; line-height: 1.2; font-weight: 600;">Độ quý hiếm hệ thống</div>
                                                    @if (eval.Reasoning != null) {
                                                        <div class="mt-2 text-muted italic" style="font-size: 10px; line-height: 1.3;"><i>@eval.Reasoning.S4_Reason</i></div>
                                                    }
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrEmpty(eval.Security_Note) && eval.Security_Note != "Normal")
                                            {
                                                <div class="mt-3 p-2 bg-warning bg-opacity-10 border border-warning rounded text-warning" style="font-size: 11px;">
                                                    <i class="fa-solid fa-triangle-exclamation me-1"></i> <strong>Lưu ý bảo mật:</strong> @eval.Security_Note
                                                </div>
                                            }
                                            <div class="mt-4 pt-3 border-top border-primary border-opacity-10 d-flex align-items-center justify-content-between">
                                                <div class="small text-primary fw-bold" style="font-size: 12px;">
                                                    <i class="fa-solid fa-chart-line me-1"></i> ĐIỂM ĐỘ QUÝ (RARENESS SCORE):
                                                </div>
                                                <div class="fw-bold text-primary" style="font-size: 24px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                                                    @eval.Evaluation.Final_Rareness_Score.ToString("F2")
                                                </div>
                                            </div>
                                            <p class="mb-0 mt-3 text-muted" style="font-size: 11px; font-style: italic; line-height: 1.4;">
                                                * Hệ thống AI tự động phân tích dựa trên NLP và ma trận trọng số để đánh giá giá trị thực tế của tài liệu.
                                            </p>
                                        </div>
                                    }
                                }
                                catch { }
                            }
                        }
                    </div>

                    <div class="card bg-light border-0 mb-4 p-4" style="border-radius: 12px;">
                        <h5 class="fw-bold mb-2">Chi tiết nội dung</h5>
                        <p class="mb-0 text-muted small">
                            Tài liệu này thuộc ngành <strong>@ViewBag.TenNganh</strong>, môn <strong>@(Model.MaMonHocNavigation?.TenMonHoc)</strong>. 
                            Được đăng tải chính thức vào ngày @Model.NgayDang?.ToString("dd/MM/yyyy").
                        </p>
                    </div>

                    @if (ViewBag.PreviewUrl == "NOT_FOUND" || string.IsNullOrEmpty((string)ViewBag.PreviewUrl))
                    {
                        <div class="alert alert-warning border-0 p-4 text-center" style="border-radius: 12px; background-color: #fff3cd; color: #664d03;">
                            <i class="fa-solid fa-circle-exclamation fs-1 mb-3 text-warning"></i>
                            <h5 class="fw-bold">DỮ LIỆU XEM TRƯỚC VỀ TÀI LIỆU NÀY TRÊN SERVER HIỆN KHÔNG CÓ. XIN VUI LÒNG THÔNG CẢM</h5>
                        </div>
                    }
                    else
                    {
                        string loaiFile = (Model.LoaiFile ?? "").ToLower().Replace(".", "").Trim();
                        bool isImage = loaiFile == "png" || loaiFile == "jpg" || loaiFile == "jpeg" || loaiFile == "gif" || loaiFile == "bmp" || loaiFile == "webp" || loaiFile == "tiff";

                        if (isImage)
                        {
                            <div class="alert alert-info border-0 p-5 text-center mb-4" style="border-radius: 16px; background-color: #f8fafc; border: 1px dashed #cbd5e1 !important; color: #1e293b; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);">
                                <i class="fa-solid fa-image fs-1 mb-3 text-secondary" style="font-size: 3rem !important;"></i>
                                <h5 class="fw-bold mb-2">TÀI LIỆU DẠNG HÌNH ẢNH</h5>
                                <p class="text-muted small mb-4">Hệ thống không hỗ trợ xem trước trực tuyến đối với tài liệu định dạng hình ảnh để bảo vệ bản quyền.</p>
                                <a href="@Url.Action("Download", "Document", new { id = Model.MaTaiLieu })" class="btn btn-success px-5 py-3 rounded-pill fw-bold border-0 shadow-lg" style="background-color: #10b981 !important; color: #fff !important; transition: all 0.25s ease;" onmouseover="this.style.backgroundColor='#059669'" onmouseout="this.style.backgroundColor='#10b981'">
                                    <i class="fa-solid fa-download me-2"></i>Tải hình ảnh về để xem chi tiết @((Model.DiemYeuCau ?? 0) > 0 ? $"({Model.DiemYeuCau} điểm)" : "")
                                </a>
                            </div>
                        }
                        else
                        {
                            bool isFullyVisible = ViewBag.IsFullyVisible ?? false;
                            
                            if (isFullyVisible)
                            {
                                <div class="card shadow-sm border-0 mb-4 p-0" style="border-radius: 12px; overflow: hidden; height: 950px; position: relative;">
                                    @{
                                        bool isOffice = loaiFile == "doc" || loaiFile == "docx" || loaiFile == "xls" || loaiFile == "xlsx" || loaiFile == "ppt" || loaiFile == "pptx";
                                        string previewUrl = ViewBag.PreviewUrl;
                                        if (isOffice)
                                        {
                                            previewUrl = "https://view.officeapps.live.com/op/embed.aspx?src=" + System.Net.WebUtility.UrlEncode(previewUrl) + "&wdStartOn=1&wdPrint=0&wdEmbedCode=0";
                                        }
                                    }
                                    
                                    <div class="preview-iframe-wrapper">
                                        <iframe src="@previewUrl"></iframe>
                                    </div>

                                    <!-- Lớp chắn chặn thao tác tải bản sao trực tiếp trên MS Word Toolbar -->
                                    <div class="iframe-blocker" style="position: absolute; bottom: 0; left: 0; right: 0; height: 45px; background: rgba(248, 250, 252, 0.01); z-index: 99; cursor: not-allowed;" title="Vui lòng tải về để sử dụng đầy đủ tính năng"></div>
                                </div>
                            }
                            else
                            {
                                @* Trường hợp bị giới hạn xem trước: parent cuộn trang chủ động để lướt qua trang 2 sẽ gặp bảng khóa và toàn bộ phần sau bị che kín *@
                                <div class="card shadow-sm border-0 mb-4 p-0" style="border-radius: 12px; overflow-y: auto; overflow-x: hidden; height: 750px; position: relative; background-color: #f1f5f9;">
                                    @{
                                        bool isOffice = loaiFile == "doc" || loaiFile == "docx" || loaiFile == "xls" || loaiFile == "xlsx" || loaiFile == "ppt" || loaiFile == "pptx";
                                        string previewUrl = ViewBag.PreviewUrl;
                                        if (isOffice)
                                        {
                                            previewUrl = "https://view.officeapps.live.com/op/embed.aspx?src=" + System.Net.WebUtility.UrlEncode(previewUrl) + "&wdStartOn=1&wdPrint=0&wdEmbedCode=0";
                                        }
                                    }
                                    
                                    @* Chiều cao 2600px đại diện cho chiều cao của nhiều trang tài liệu. pointer-events: none để sự kiện cuộn chuột chuyển thẳng lên lớp cha *@
                                    <div style="width: 100%; height: 2600px; position: relative; pointer-events: none;">
                                        <iframe src="@previewUrl" style="position: absolute; inset: 0; width: 118% !important; height: 2600px !important; transform: scale(0.85); transform-origin: top left; border: none; overflow: hidden;"></iframe>
                                    </div>

                                    <!-- Lớp chắn chặn thao tác tải bản sao trực tiếp trên MS Word Toolbar -->
                                    <div class="iframe-blocker" style="position: absolute; bottom: 0; left: 0; right: 0; height: 45px; background: rgba(248, 250, 252, 0.01); z-index: 99; cursor: not-allowed;" title="Vui lòng tải về để sử dụng đầy đủ tính năng"></div>

                                    <!-- Lớp phủ mờ (Fade Out & Blur) bắt đầu từ trang 3 (top: 620px) với chiều cao 2000px phủ kín hoàn toàn các trang sau -->
                                    <div class="preview-blur-overlay" style="position: absolute; left: 0; right: 0; top: 620px; height: 2000px; background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0.98) 120px, #f1f5f9 250px, #f1f5f9 100%); z-index: 100; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 140px; text-align: center; pointer-events: auto;">
                                        <div class="blur-cta-box p-4 p-md-5 shadow-lg border-0" style="border-radius: 24px; max-width: 580px; margin: 0 15px; background: #2d4045 !important; color: #ffffff !important; box-shadow: 0 15px 40px rgba(45, 64, 69, 0.4) !important;">
                                            <div class="mb-3">
                                                <i class="fa-solid fa-lock text-warning" style="font-size: 2.2rem;"></i>
                                            </div>
                                            <h4 class="fw-bold mb-2 text-white" style="letter-spacing: 0.5px;">Đây là bản xem trước</h4>
                                            <p class="text-white-50 small mb-4 px-3" style="font-size: 0.95rem; line-height: 1.5;">Bạn muốn xem đầy đủ vui lòng tải tài liệu để tìm hiểu nội dung rõ hơn</p>
                                            
                                            <!-- Điểm nổi bật tương tự hình ảnh tham khảo -->
                                            <div class="d-flex flex-wrap justify-content-center gap-3 text-white-50 small mb-4 pb-2" style="font-size: 0.85rem; border-bottom: 1px solid rgba(255,255,255,0.1);">
                                                <span><i class="fa-solid fa-check text-success me-1"></i> Không giới hạn trang</span>
                                                <span><i class="fa-solid fa-check text-success me-1"></i> Tải file gốc tốc độ cao</span>
                                                <span><i class="fa-solid fa-check text-success me-1"></i> Hỗ trợ học tập tối ưu</span>
                                            </div>

                                            <a href="@Url.Action("Download", "Document", new { id = Model.MaTaiLieu })" class="btn btn-success px-5 py-3 rounded-pill fw-bold border-0 shadow-lg" style="background-color: #10b981 !important; color: #fff !important; transition: all 0.25s ease;" onmouseover="this.style.backgroundColor='#059669'" onmouseout="this.style.backgroundColor='#10b981'">
                                                <i class="fa-solid fa-download me-2"></i>Tải xuống để xem đầy đủ @((Model.DiemYeuCau ?? 0) > 0 ? $"({Model.DiemYeuCau} điểm)" : "")
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }

                    <div class="row mb-4">
                        <div class="col-4">
                            <button class="btn btn-outline-secondary w-100 rounded-pill small" onclick="toggleSave(event, '@Model.MaTaiLieu')">
                                <i class="fa-star me-1 @((ViewBag.IsSaved != null && ViewBag.IsSaved == true) ? "fa-solid text-warning" : "fa-regular")" id="saveIcon1"></i> <span id="saveText1">@(ViewBag.IsSaved != null && ViewBag.IsSaved == true ? "Đã lưu" : "Lưu")</span>
                            </button>
                        </div>
                        <div class="col-4">
                            <button class="btn btn-outline-secondary w-100 rounded-pill small" onclick="toggleLike(event, '@Model.MaTaiLieu')">
                                <i class="fa-heart fa-regular me-1" id="likeIcon1"></i> <span id="likeText1">Thích</span>
                            </button>
                        </div>
                        <div class="col-4"><button class="btn btn-outline-secondary w-100 rounded-pill small"><i class="fa-solid fa-share me-1"></i> Gửi</button></div>
                    </div>

                    <div class="mb-4">
                        <h5 class="fw-bold mb-3">Đánh giá & Phản hồi</h5>
                        <div class="d-flex align-items-center mb-4">
                            <div class="text-warning me-3">
                                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-regular fa-star"></i>
                            </div>
                            <span class="fw-bold">4.0/5</span>
                            <span class="ms-3 text-muted small">(@Model.DanhGia.Count lượt)</span>
                        </div>

                        <div class="comment-list">
                            @foreach (var bl in ViewBag.Comments)
                            {
                                <div class="d-flex mb-3">
                                    <div class="avatar-sm bg-info text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width:35px; height:35px; font-size:12px;">
                                        @(bl.TenSv?.Substring(0,1).ToUpper())
                                    </div>
                                    <div class="bg-light rounded-3 p-2 flex-grow-1">
                                        <div class="fw-bold" style="font-size:12px;">@bl.TenSv</div>
                                        <p class="mb-0 small">@bl.NoiDung</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-12">
                <div class="card shadow-sm border-0 mb-4" style="border-radius: 12px; overflow: hidden;">
                    <div class="card-header bg-white py-3 border-0">
                        <h5 class="fw-bold mb-0">Thông tin tài liệu</h5>
                    </div>
                    <div class="card-body p-4 pt-0">
                        <div class="uploader-info d-flex align-items-center p-3 mb-3 bg-light rounded-3">
                            <div class="avatar-lg bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width:50px; height:50px; font-size:18px;">
                                @(ViewBag.NguoiDang?.TenSv?.Substring(0,1).ToUpper())
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">@ViewBag.NguoiDang?.TenSv</div>
                                <div class="text-muted" style="font-size:11px;">Người đăng tài liệu</div>
                            </div>
                        </div>

                        <div class="download-stats border-top pt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Lượt tải:</span>
                                <span class="fw-bold small">@Model.LuotTai</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted small">Phí tải xuống:</span>
                                <span class="fw-bold text-danger small">
                                    <i class="fa-solid fa-minus-circle me-1"></i> @Model.DiemYeuCau điểm
                                </span>
                            </div>
                            <div class="alert alert-warning p-2 mt-2 mb-3" style="font-size: 11px; border-radius: 8px;">
                                <i class="fa-solid fa-circle-info me-1"></i> 
                                Sinh viên sẽ bị trừ <strong>@Model.DiemYeuCau điểm</strong> khi tải tài liệu này.
                            </div>
                            <div class="d-flex justify-content-between mb-4">
                                <span class="text-muted small">Định dạng:</span>
                                <span class="badge bg-secondary rounded-pill text-uppercase">@Model.LoaiFile</span>
                            </div>

                            <a href="javascript:void(0)" onclick="handleDownload('@Model.MaTaiLieu')" class="btn btn-success w-100 py-3 rounded-pill fw-bold border-0 shadow-sm mb-3">
                                <i class="fa-solid fa-download me-2"></i>TẢI XUỐNG NGAY
                            </a>

                            <div class="text-center">
                                <a href="#" class="text-decoration-none small d-block mb-2" onclick="toggleSave(event, '@Model.MaTaiLieu')">
                                    <i class="fa-heart me-1 @((ViewBag.IsSaved != null && ViewBag.IsSaved == true) ? "fa-solid text-danger" : "fa-regular")" id="saveIcon2"></i>
                                    <span id="saveText2">@(ViewBag.IsSaved != null && ViewBag.IsSaved == true ? "Đã lưu" : "Lưu vào yêu thích")</span>
                                </a>
                                <hr class="my-2 opacity-25">
                                @* Tìm nút Báo cáo ở Sidebar trang chi tiết và sửa href *@
<a href="/Document/RecentReports?id=@Model.MaTaiLieu" class="text-danger small text-decoration-none">
    <i class="fa-solid fa-flag me-1"></i>Báo cáo vi phạm tài liệu này
</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar-sm, .avatar-lg { flex-shrink: 0; }
    .card { transition: 0.3s; }
    .btn-success { background-color: #198754 !important; }
    .btn-success:hover { background-color: #157347 !important; transform: translateY(-2px); }

    /* Tăng cỡ chữ theo yêu cầu */
    body { font-size: 16px; }
    .page-head h1 { font-size: 2.2rem !important; }
    .page-head p { font-size: 1.1rem !important; }
    .card h2 { font-size: 2rem !important; }
    .card h5 { font-size: 1.3rem !important; }
    .text-muted p { font-size: 1.1rem !important; }
    .download-stats span, .download-stats b { font-size: 1rem !important; }
    .comment-list p { font-size: 1rem !important; }

    /* Wrapper tỷ lệ thu nhỏ thông minh loại bỏ cuộn ngang */
    .preview-iframe-wrapper {
        width: 100%;
        height: 100%;
        overflow: hidden;
        position: relative;
        background: #f8fafc;
        overflow-y: hidden !important;
    }
    .preview-iframe-wrapper iframe {
        width: 118% !important;
        height: 118% !important;
        transform: scale(0.85);
        transform-origin: top left;
        border: none;
        overflow-y: hidden !important;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            let maTL = '@Model.MaTaiLieu';
            let key = 'liked_' + maTL;
            if (localStorage.getItem(key) === 'true') {
                let l1 = document.getElementById('likeIcon1');
                let lt1 = document.getElementById('likeText1');
                if (l1) { l1.classList.remove('fa-regular'); l1.classList.add('fa-solid', 'text-danger'); }
                if (lt1) { lt1.innerText = 'Đã thích'; }
            }
        });

        function toggleLike(e, maTL) {
            e.preventDefault();
            let key = 'liked_' + maTL;
            let l1 = document.getElementById('likeIcon1');
            let lt1 = document.getElementById('likeText1');
            
            if (localStorage.getItem(key) === 'true') {
                localStorage.removeItem(key);
                if (l1) { l1.classList.remove('fa-solid', 'text-danger'); l1.classList.add('fa-regular'); }
                if (lt1) { lt1.innerText = 'Thích'; }
            } else {
                localStorage.setItem(key, 'true');
                if (l1) { l1.classList.remove('fa-regular'); l1.classList.add('fa-solid', 'text-danger'); }
                if (lt1) { lt1.innerText = 'Đã thích'; }
            }
        }

        function toggleSave(e, maTL) {
            e.preventDefault();
            $.post('/Document/ToggleSave', { maTL: maTL }, function(res) {
                if(res.success) {
                    let s1 = document.getElementById('saveIcon1');
                    let s2 = document.getElementById('saveIcon2');
                    let t1 = document.getElementById('saveText1');
                    let t2 = document.getElementById('saveText2');

                    if(res.saved) {
                        if(s1) { s1.classList.remove('fa-regular'); s1.classList.add('fa-solid', 'text-warning'); t1.innerText = 'Đã lưu'; }
                        if(s2) { s2.classList.remove('fa-regular'); s2.classList.add('fa-solid', 'text-danger'); t2.innerText = 'Đã lưu'; }
                    } else {
                        if(s1) { s1.classList.remove('fa-solid', 'text-warning'); s1.classList.add('fa-regular'); t1.innerText = 'Lưu'; }
                        if(s2) { s2.classList.remove('fa-solid', 'text-danger'); s2.classList.add('fa-regular'); t2.innerText = 'Lưu vào yêu thích'; }
                    }
                } else {
                    alert(res.message);
                }
            });
        }

        function handleDownload(maTL) {
            $.get('/Document/CheckDownloadPoints', { id: maTL }, function (res) {
                if (res.success) {
                    if (res.confirmNeeded) {
                        if (confirm(`Tải tài liệu này sẽ trừ ${res.points} điểm tích lũy của bạn. Bạn có chắc chắn muốn tải không?`)) {
                            window.location.href = '/Document/Download/' + maTL;
                        }
                    } else {
                        window.location.href = '/Document/Download/' + maTL;
                    }
                } else {
                    alert(res.message);
                }
            });
        }
    </script>
}