@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Danh mục tài liệu";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

<div class="main-content-wrap py-5">
    <div class="container-fluid px-lg-5">
        <!-- Breadcrumbs & Header -->
        <div class="row mb-5 align-items-end">
            <div class="col-md-8">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2 bg-transparent p-0" style="font-size: 0.85rem;">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="breadcrumb-item active text-primary fw-medium" aria-current="page">Danh mục tài liệu</li>
                    </ol>
                </nav>
                <h1 class="fw-800 mb-0" style="font-size: 1.75rem; color: #1e293b;">Khám phá tài liệu</h1>
            </div>
            <div class="col-md-4 text-md-end mt-3 mt-md-0">
                <p class="text-muted small mb-0"><i class="fa-solid fa-circle-info me-1"></i> Tìm thấy <span class="fw-bold text-dark">@Model.Count()</span> tài liệu</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Category Sidebar -->
            <div class="col-md-4 col-lg-3">
                <div class="category-sidebar sticky-top" style="top: 106px;">
                    <div class="card border-0 shadow-soft" style="border-radius: 20px;">
                        <div class="card-header bg-white py-4 px-4 border-0">
                            <h6 class="fw-800 mb-0 d-flex align-items-center" style="color: #004d73;">
                                <span class="bg-primary-soft p-2 rounded-3 me-3">
                                    <i class="fa-solid fa-layer-group"></i>
                                </span>
                                Danh mục
                            </h6>
                        </div>
                        <div class="card-body p-0 pb-4 scroll-slim" style="max-height: calc(100vh - 250px); overflow-y: auto;">
                            <ul class="list-unstyled custom-tree-menu">
                                @foreach (var khoa in ViewBag.DanhMuc)
                                {
                                    <li class="category-item border-bottom-soft">
                                        <div class="folder-toggle d-flex align-items-center px-4 py-3" style="cursor: pointer;">
                                            <i class="fa-solid fa-chevron-right me-3 small toggle-icon text-muted" style="font-size: 0.6rem;"></i>
                                            <span class="category-name fw-semibold text-dark">@khoa.TenKhoa</span>
                                        </div>
                                        
                                        <ul class="list-unstyled sub-menu bg-light-subtle" style="display: none;">
                                            @foreach (var nganh in khoa.Nganhs)
                                            {
                                                <li class="sub-category-item ps-4 border-bottom-soft">
                                                    <div class="nganh-toggle d-flex align-items-center px-4 py-2-5" style="cursor: pointer;">
                                                        <i class="fa-solid fa-chevron-right me-3 small toggle-icon text-muted" style="font-size: 0.5rem;"></i>
                                                        <span class="text-secondary small fw-medium">@nganh.TenNganh</span>
                                                    </div>
                                                    
                                                    <ul class="list-unstyled sub-menu bg-white" style="display: none;">
                                                        @foreach (var mon in nganh.MonHocs)
                                                        {
                                                            <li class="mon-item ps-5">
                                                                <a href="/Document/Index?idMon=@mon.MaMonHoc&searchString=@ViewBag.SearchString" 
                                                                   class="d-flex align-items-center justify-content-between py-2-5 pe-4 text-decoration-none @(ViewBag.CurrentMon == mon.MaMonHoc ? "text-primary active-mon" : "text-muted hover-link")">
                                                                    <span class="small">@mon.TenMonHoc</span>
                                                                    <span class="badge rounded-pill bg-light text-muted fw-normal" style="font-size: 0.65rem;">@mon.TaiLieus.Count</span>
                                                                </a>
                                                            </li>
                                                        }
                                                    </ul>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Document List -->
            <div class="col-md-8 col-lg-9">
                <!-- Search Section -->
                <div class="card border-0 shadow-soft mb-4" style="border-radius: 20px;">
                    <div class="card-body p-4">
                        <form asp-action="Index" method="get" class="d-flex flex-column flex-md-row gap-3">
                            <input type="hidden" name="idMon" value="@ViewBag.CurrentMon" />
                            <div class="flex-grow-1 position-relative">
                                <i class="fa-solid fa-magnifying-glass position-absolute text-muted" style="left: 20px; top: 18px;"></i>
                                <input type="text" name="searchString" value="@ViewBag.SearchString" 
                                       class="form-control form-control-lg ps-5 rounded-pill border-0 bg-light shadow-none" 
                                       placeholder="Nhập tên tài liệu, môn học hoặc giảng viên..."
                                       style="padding-top: 14px; padding-bottom: 14px; font-size: 0.95rem;">
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-primary-soft fw-bold" 
                                        style="background: #004d73; padding-top: 14px; padding-bottom: 14px;">
                                    Tìm kiếm
                                </button>
                                @if (!string.IsNullOrEmpty(ViewBag.SearchString) || !string.IsNullOrEmpty(ViewBag.CurrentMon))
                                {
                                    <a href="/Document/Index" class="btn btn-light rounded-pill px-4 d-flex align-items-center text-muted" style="padding-top: 14px; padding-bottom: 14px;">
                                        <i class="fa-solid fa-rotate-left"></i>
                                    </a>
                                }
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Table Content -->
                <div class="card border-0 shadow-soft overflow-hidden" style="border-radius: 20px;">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 custom-table">
                            <thead>
                                <tr>
                                    <th class="ps-4 py-4 text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.7rem; width: 40%;">Tài liệu</th>
                                    <th class="py-4 text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.7rem;">Người đăng</th>
                                    <th class="py-4 text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.7rem;">Ngày đăng</th>
                                    <th class="py-4 text-uppercase tracking-wider fw-bold text-muted" style="font-size: 0.7rem;">Thông tin</th>
                                    <th class="py-4 text-uppercase tracking-wider fw-bold text-muted text-center" style="font-size: 0.7rem;">Tải</th>
                                    <th class="pe-4 py-4 text-end" style="width: 100px;"></th>
                                </tr>
                            </thead>
                            <tbody class="border-top-0">
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5">
                                            <div class="py-4">
                                                <i class="fa-solid fa-folder-open text-light mb-3" style="font-size: 4rem;"></i>
                                                <p class="text-muted">Không tìm thấy tài liệu nào phù hợp.</p>
                                                <a href="/Document/Index" class="btn btn-link text-primary text-decoration-none">Hiển thị tất cả</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4 py-4">
                                            <div class="d-flex align-items-center">
                                                <div class="doc-icon-wrap me-3 d-none d-lg-flex">
                                                    <i class="fa-regular fa-file-lines text-primary" style="font-size: 1.2rem;"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark mb-1" title="@item.Data.TieuDe">@item.Data.TieuDe</div>
                                                    <div class="text-muted small d-flex align-items-center">
                                                        <i class="fa-solid fa-book-bookmark me-1 opacity-50" style="font-size: 0.7rem;"></i>
                                                        @item.TenMon
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm me-2 d-none d-sm-flex">
                                                    @item.TenNguoiDang.Substring(0, 1).ToUpper()
                                                </div>
                                                <span class="small fw-medium text-secondary">@item.TenNguoiDang</span>
                                            </div>
                                        </td>
                                        <td class="py-4">
                                            <div class="small text-muted">
                                                @if (item.Data.NgayDang != null)
                                                {
                                                    <span>@(((DateTime)item.Data.NgayDang).ToString("dd/MM/yyyy"))</span>
                                                    <div class="text-xs opacity-50">@(((DateTime)item.Data.NgayDang).ToString("HH:mm"))</div>
                                                }
                                                else
                                                {
                                                    <span class="opacity-50">---</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="py-4">
                                            @if (item.Data.NamXb != null || !string.IsNullOrEmpty(item.Data.Nxb))
                                            {
                                                <div class="small text-dark fw-medium line-clamp-1" title="@item.Data.Nxb">@(item.Data.Nxb ?? "NXB")</div>
                                                <div class="text-xs text-muted">@(item.Data.NamXb != null ? "Năm: " + item.Data.NamXb : "")</div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted fw-normal border" style="font-size: 0.65rem; border-radius: 4px;">Nội bộ</span>
                                            }
                                        </td>
                                        <td class="py-4 text-center">
                                            <span class="fw-bold text-primary">@item.Data.LuotTai</span>
                                        </td>
                                        <td class="pe-4 py-4 text-end">
                                            <a href="/Document/Details/@item.Data.MaTaiLieu" class="btn btn-view-doc">
                                                Xem
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --primary-soft: #eef7fc;
        --border-soft: #f1f5f9;
        --shadow-soft-val: 0 10px 30px rgba(0, 0, 0, 0.04);
        --fw-800: 800;
    }

    .fw-800 { font-weight: 800; }
    .shadow-soft { box-shadow: var(--shadow-soft-val); }
    .shadow-primary-soft { box-shadow: 0 4px 14px rgba(0, 77, 115, 0.25); }
    .bg-primary-soft { background-color: var(--primary-soft); color: #004d73; }
    .border-bottom-soft { border-bottom: 1px solid var(--border-soft); }
    
    .custom-tree-menu .folder-toggle:hover { background-color: #f8fafc; }
    .custom-tree-menu .toggle-icon { transition: transform 0.3s ease; }
    .custom-tree-menu .rotate-90 { transform: rotate(90deg); color: #004d73 !important; }
    
    .py-2-5 { padding-top: 0.625rem; padding-bottom: 0.625rem; }
    
    .hover-link:hover { color: #004d73 !important; background-color: #f8fafc; }
    .active-mon { background-color: #eef7fc; font-weight: 700; border-right: 3px solid #004d73; }
    
    .scroll-slim::-webkit-scrollbar { width: 4px; }
    .scroll-slim::-webkit-scrollbar-track { background: transparent; }
    .scroll-slim::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    
    .custom-table thead { background-color: #fcfdfe; }
    .custom-table tbody tr { transition: all 0.2s; }
    .custom-table tbody tr:hover { background-color: #f8fbff; transform: scale(1.002); }
    
    .doc-icon-wrap {
        width: 40px;
        height: 40px;
        background: #f0f7ff;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    
    .avatar-sm {
        width: 24px;
        height: 24px;
        background: #e2e8f0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 800;
        color: #64748b;
    }
    
    .btn-view-doc {
        background: #004d73;
        color: white;
        border-radius: 10px;
        padding: 8px 20px;
        font-weight: 600;
        font-size: 0.85rem;
        border: none;
        transition: all 0.2s;
    }
    .btn-view-doc:hover {
        background: #003d5c;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .text-xs { font-size: 0.7rem; }
    .tracking-wider { letter-spacing: 0.05em; }
    
    @@media (max-width: 768px) {
        .category-sidebar { position: static !important; margin-bottom: 2rem; }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // --- XỬ LÝ CÂY THƯ MỤC ---
            $('.folder-toggle, .nganh-toggle').click(function (e) {
                var subMenu = $(this).next('.sub-menu');
                var icon = $(this).find('.toggle-icon');
                
                subMenu.slideToggle(300);
                icon.toggleClass('rotate-90');
            });

            // Tự động mở cây thư mục tại vị trí đang chọn
            $('.active-mon').parents('.sub-menu').show();
            $('.active-mon').parents('.sub-menu').prev().find('.toggle-icon').addClass('rotate-90');
        });
    </script>
}