@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<style>
    .profile-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px;
    }

    .profile-header {
        background: linear-gradient(135deg, #004d73 0%, #0077b6 100%);
        border-radius: 16px;
        padding: 40px;
        color: white;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(0, 77, 115, 0.2);
    }

    .profile-header-content {
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .profile-avatar-large {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: white;
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 700;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        flex-shrink: 0;
    }

    .profile-header-info h1 {
        font-size: 32px;
        font-weight: 800;
        margin: 0 0 8px 0;
    }

    .profile-header-meta {
        display: flex;
        gap: 24px;
        margin-top: 16px;
        flex-wrap: wrap;
    }

    .profile-meta-item {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.2);
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 14px;
    }

    .profile-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 968px) {
        .profile-grid {
            grid-template-columns: 1fr;
        }
    }

    .profile-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .profile-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid var(--border-light);
    }

    .profile-card-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .profile-form-group {
        margin-bottom: 20px;
    }

    .profile-form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-sec);
        margin-bottom: 8px;
    }

    .profile-form-input {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid var(--border);
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.2s;
    }

    .profile-form-input:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(0, 77, 115, 0.1);
    }

    .profile-form-input:disabled {
        background: var(--bg);
        color: var(--text-light);
        cursor: not-allowed;
    }

    .profile-info-row {
        display: flex;
        justify-content: space-between;
        padding: 16px 0;
        border-bottom: 1px solid var(--border-light);
    }

    .profile-info-row:last-child {
        border-bottom: none;
    }

    .profile-info-label {
        font-size: 14px;
        color: var(--text-sec);
        font-weight: 500;
    }

    .profile-info-value {
        font-size: 14px;
        color: var(--text);
        font-weight: 600;
    }

    .profile-btn {
        padding: 12px 24px;
        border: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .profile-btn-primary {
        background: var(--primary);
        color: white;
    }

    .profile-btn-primary:hover {
        background: var(--primary-dark);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 77, 115, 0.3);
    }

    .profile-btn-secondary {
        background: var(--bg);
        color: var(--text);
    }

    .profile-btn-secondary:hover {
        background: var(--border);
    }

    .profile-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none !important;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
        display: none;
    }

    .alert-success {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #c8e6c9;
    }

    .alert-error {
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ffcdd2;
    }

    .alert.show {
        display: block;
        animation: slideDown 0.3s ease;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .loading-skeleton {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        border-radius: 4px;
        height: 20px;
    }

    @@keyframes loading {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }
</style>

<div class="profile-container">
    <!-- Grid -->
    <div class="profile-grid">
        <!-- Left Column -->
        <div>
            <!-- Thông tin tài khoản (Read-only) -->
            <div class="profile-card">
                <div class="profile-card-header">
                    <h2 class="profile-card-title">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                            <circle cx="12" cy="16" r="1"/>
                        </svg>
                        <span>Thông tin tài khoản</span>
                    </h2>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Họ và tên</span>
                    <span class="profile-info-value" id="infoName">-</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Vai trò</span>
                    <span class="profile-info-value" id="infoRole">-</span>
                </div>

                <div class="profile-info-row">
                    <span class="profile-info-label">Mã người dùng</span>
                    <span class="profile-info-value" id="infoUserId">-</span>
                </div>

                <div class="profile-info-row" id="infoLopRow" style="display: none;">
                    <span class="profile-info-label">Lớp</span>
                    <span class="profile-info-value" id="infoLop">-</span>
                </div>

                <div class="profile-info-row" id="infoKhoaRow" style="display: none;">
                    <span class="profile-info-label">Khoa</span>
                    <span class="profile-info-value" id="infoKhoa">-</span>
                </div>

                <div class="profile-info-row" id="infoPointsRow" style="display: none;">
                    <span class="profile-info-label">Điểm tích lũy</span>
                    <span class="profile-info-value" id="infoPoints" style="color: var(--primary); font-weight: 700;">0</span>
                </div>
            </div>

            <!-- Thông tin cá nhân (Editable) -->
            <div class="profile-card" style="margin-top: 24px;">
                <div class="profile-card-header">
                    <h2 class="profile-card-title">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                        <span>Thông tin cá nhân</span>
                    </h2>
                    <button class="profile-btn profile-btn-secondary" onclick="toggleEditMode()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="editBtnIcon">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                        <span id="editBtnText">Chỉnh sửa</span>
                    </button>
                </div>

                <div id="alertContainer"></div>

                <form id="profileForm">
                    <div class="profile-form-group">
                        <label class="profile-form-label">Email</label>
                        <input type="email" class="profile-form-input" id="inputEmail" disabled>
                    </div>

                    <div class="profile-form-group">
                        <label class="profile-form-label">Ngày sinh</label>
                        <input type="date" class="profile-form-input" id="inputNgaySinh" disabled>
                    </div>

                    <div class="profile-form-group">
                        <label class="profile-form-label">Giới tính</label>
                        <select class="profile-form-input" id="inputGioiTinh" disabled>
                            <option value="">Chọn giới tính</option>
                            <option value="Nam">Nam</option>
                            <option value="Nữ">Nữ</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>

                    <div class="profile-form-group" id="sdtGroup" style="display: none;">
                        <label class="profile-form-label">Số điện thoại</label>
                        <input type="tel" class="profile-form-input" id="inputSdt" disabled>
                    </div>

                    <div id="editActions" style="display: none; margin-top: 24px;">
                        <button type="button" class="profile-btn profile-btn-primary" onclick="saveProfile()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/>
                                <polyline points="7 3 7 8 15 8"/>
                            </svg>
                            <span>Lưu thay đổi</span>
                        </button>
                        <button type="button" class="profile-btn profile-btn-secondary" onclick="cancelEdit()">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"/>
                                <line x1="6" y1="6" x2="18" y2="18"/>
                            </svg>
                            <span>Hủy</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Right Column -->
        <div>
            <!-- Đổi mật khẩu -->
            <div class="profile-card">
                <div class="profile-card-header">
                    <h2 class="profile-card-title">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                        </svg>
                        <span>Đổi mật khẩu</span>
                    </h2>
                </div>

                <div id="passwordAlertContainer"></div>

                <form id="passwordForm">
                    <div class="profile-form-group">
                        <label class="profile-form-label">Mật khẩu cũ</label>
                        <input type="password" class="profile-form-input" id="inputOldPassword" required>
                    </div>

                    <div class="profile-form-group">
                        <label class="profile-form-label">Mật khẩu mới</label>
                        <input type="password" class="profile-form-input" id="inputNewPassword" required minlength="6">
                    </div>

                    <div class="profile-form-group">
                        <label class="profile-form-label">Xác nhận mật khẩu mới</label>
                        <input type="password" class="profile-form-input" id="inputConfirmPassword" required>
                    </div>

                    <button type="submit" class="profile-btn profile-btn-primary">
                        <span>Đổi mật khẩu</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/auth.js"></script>
<script>
    let isEditMode = false;
    let originalData = {};

    // Load dữ liệu khi trang load
    document.addEventListener('DOMContentLoaded', function() {
        loadProfileData();
    });

    function loadProfileData() {
        console.log('🔄 Đang tải thông tin profile...');

        // Lấy dữ liệu từ localStorage
        if (!AuthManager.isLoggedIn()) {
            window.location.href = '/Auth/Login';
            return;
        }

        const userInfo = AuthManager.getUserInfo();
        console.log('👤 User info từ localStorage:', userInfo);

        // Fill dữ liệu vào form
        fillProfileData(userInfo);
    }

    function fillProfileData(data) {
        console.log('📝 Dữ liệu nhận được:', data);
        console.log('📝 Các keys:', Object.keys(data));
        
        // Thông tin tài khoản (Read-only) - thử cả PascalCase và camelCase
        const tenNguoiDung = data.TenNguoiDung || data.tenNguoiDung || '';
        document.getElementById('infoName').textContent = tenNguoiDung || '-';
        document.getElementById('infoRole').textContent = data.TenVaiTro || data.tenVaiTro || data.LoaiNguoiDung || data.loaiNguoiDung || '-';
        document.getElementById('infoUserId').textContent = data.MaNguoiDung || data.maNguoiDung || '-';
        
        const loaiNguoiDung = data.LoaiNguoiDung || data.loaiNguoiDung || '';
        console.log('👤 Loại người dùng:', loaiNguoiDung);
        
        // Hiển thị điểm tích lũy cho sinh viên
        if (loaiNguoiDung === 'SinhVien' || loaiNguoiDung === 'sinhvien') {
            document.getElementById('infoPointsRow').style.display = 'flex';
            document.getElementById('infoPoints').textContent = `${data.DiemTichLuy || data.diemTichLuy || 0} điểm`;
            document.getElementById('infoLopRow').style.display = 'flex';
            document.getElementById('infoLop').textContent = data.MaLop || data.maLop || '-';
        } else if (loaiNguoiDung === 'GiangVien' || loaiNguoiDung === 'giangvien') {
            document.getElementById('infoKhoaRow').style.display = 'flex';
            document.getElementById('infoKhoa').textContent = data.MaKhoa || data.maKhoa || '-';
        }

        // Form thông tin cá nhân (Editable)
        document.getElementById('inputEmail').value = data.Email || data.email || '';
        document.getElementById('inputGioiTinh').value = data.GioiTinh || data.gioiTinh || '';

        // Ngày sinh (convert từ DD/MM/YYYY sang YYYY-MM-DD)
        const ngaySinh = data.NgaySinh || data.ngaySinh;
        if (ngaySinh) {
            const parts = ngaySinh.split('/');
            if (parts.length === 3) {
                document.getElementById('inputNgaySinh').value = `${parts[2]}-${parts[1]}-${parts[0]}`;
            }
        }

        // Số điện thoại (chỉ cho giảng viên)
        if (loaiNguoiDung === 'GiangVien' || loaiNguoiDung === 'giangvien') {
            document.getElementById('sdtGroup').style.display = 'block';
            document.getElementById('inputSdt').value = data.Sdt || data.sdt || '';
        }

        // Lưu dữ liệu gốc
        originalData = { ...data };

        console.log('✅ Đã fill dữ liệu profile');
    }

    function toggleEditMode() {
        isEditMode = !isEditMode;

        const inputs = ['inputEmail', 'inputNgaySinh', 'inputGioiTinh'];
        if (document.getElementById('sdtGroup').style.display !== 'none') {
            inputs.push('inputSdt');
        }

        inputs.forEach(id => {
            document.getElementById(id).disabled = !isEditMode;
        });

        document.getElementById('editActions').style.display = isEditMode ? 'block' : 'none';
        
        // Thay đổi icon
        const editIcon = document.getElementById('editBtnIcon');
        if (isEditMode) {
            editIcon.innerHTML = `<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>`;
        } else {
            editIcon.innerHTML = `<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>`;
        }
        
        document.getElementById('editBtnText').textContent = isEditMode ? 'Hủy' : 'Chỉnh sửa';

        if (!isEditMode) {
            // Reset về dữ liệu gốc
            fillProfileData(originalData);
        }
    }

    function cancelEdit() {
        toggleEditMode();
    }

    async function saveProfile() {
        try {
            const data = {
                email: document.getElementById('inputEmail').value,
                gioiTinh: document.getElementById('inputGioiTinh').value,
                ngaySinh: document.getElementById('inputNgaySinh').value ? 
                    new Date(document.getElementById('inputNgaySinh').value).toISOString().split('T')[0] : null,
                sdt: document.getElementById('inputSdt').value
            };

            const response = await fetch('/Profile/UpdateProfile', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (result.success) {
                showAlert('alertContainer', 'success', result.message);
                
                // Cập nhật localStorage với PascalCase
                const userInfo = AuthManager.getUserInfo();
                userInfo.Email = data.email;
                userInfo.GioiTinh = data.gioiTinh;
                if (data.ngaySinh) {
                    // Convert back to DD/MM/YYYY format
                    const date = new Date(data.ngaySinh);
                    userInfo.NgaySinh = `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`;
                }
                if (data.sdt) {
                    userInfo.Sdt = data.sdt;
                }
                AuthManager.saveUserInfo(userInfo);
                
                // Cập nhật header
                if (window.updateHeaderFromLocalStorage) {
                    window.updateHeaderFromLocalStorage();
                }
                
                toggleEditMode();
            } else {
                showAlert('alertContainer', 'error', result.message);
            }
        } catch (error) {
            console.error('Lỗi:', error);
            showAlert('alertContainer', 'error', 'Có lỗi xảy ra khi lưu thông tin');
        }
    }

    // Xử lý đổi mật khẩu
    document.getElementById('passwordForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const oldPassword = document.getElementById('inputOldPassword').value;
        const newPassword = document.getElementById('inputNewPassword').value;
        const confirmPassword = document.getElementById('inputConfirmPassword').value;

        if (newPassword !== confirmPassword) {
            showAlert('passwordAlertContainer', 'error', 'Mật khẩu xác nhận không khớp!');
            return;
        }

        try {
            const response = await fetch('/Profile/ChangePassword', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    oldPassword,
                    newPassword,
                    confirmPassword
                })
            });

            const result = await response.json();

            if (result.success) {
                showAlert('passwordAlertContainer', 'success', result.message);
                document.getElementById('passwordForm').reset();
            } else {
                showAlert('passwordAlertContainer', 'error', result.message);
            }
        } catch (error) {
            console.error('Lỗi:', error);
            showAlert('passwordAlertContainer', 'error', 'Có lỗi xảy ra khi đổi mật khẩu');
        }
    });

    function showAlert(containerId, type, message) {
        const container = document.getElementById(containerId);
        const icon = type === 'success' 
            ? `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 12l3 3 5-6"/>
               </svg>`
            : `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align: middle; margin-right: 6px;">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
               </svg>`;
        
        container.innerHTML = `
            <div class="alert alert-${type} show">
                ${icon}${message}
            </div>
        `;

        setTimeout(() => {
            const alert = container.querySelector('.alert');
            if (alert) {
                alert.classList.remove('show');
                setTimeout(() => container.innerHTML = '', 300);
            }
        }, 5000);
    }
</script>
