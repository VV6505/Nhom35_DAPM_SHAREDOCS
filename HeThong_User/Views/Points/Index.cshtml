@{
    ViewData["Title"] = "Điểm tích lũy";
}

<style>
    .points-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 24px;
    }

    .points-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 32px;
    }

    .points-stat-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s;
    }

    .points-stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    .points-stat-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .points-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .points-stat-icon.green {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .points-stat-icon.red {
        background: #ffebee;
        color: #c62828;
    }

    .points-stat-icon.blue {
        background: #e3f2fd;
        color: #1976d2;
    }

    .points-stat-icon.purple {
        background: #f3e5f5;
        color: #7b1fa2;
    }

    .points-stat-icon svg {
        stroke: currentColor;
    }

    .points-stat-label {
        font-size: 13px;
        color: var(--text-sec);
        font-weight: 500;
    }

    .points-stat-value {
        font-size: 32px;
        font-weight: 800;
        color: var(--text);
    }

    .points-stat-trend {
        font-size: 12px;
        color: var(--text-light);
        margin-top: 4px;
    }

    .points-history-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .points-history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid var(--border-light);
    }

    .points-history-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .points-filter {
        display: flex;
        gap: 8px;
    }

    .points-filter-select {
        padding: 8px 16px;
        border: 2px solid var(--border);
        background: white;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        min-width: 200px;
    }

    .points-filter-select:hover {
        border-color: var(--primary);
    }

    .points-filter-select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .points-timeline {
        position: relative;
    }

    .points-timeline::before {
        content: '';
        position: absolute;
        left: 24px;
        top: 0;
        bottom: 0;
        width: 2px;
        background: var(--border-light);
    }

    .points-timeline-item {
        position: relative;
        padding-left: 64px;
        padding-bottom: 32px;
    }

    .points-timeline-item:last-child {
        padding-bottom: 0;
    }

    .points-timeline-dot {
        position: absolute;
        left: 16px;
        top: 4px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 3px solid white;
        box-shadow: 0 0 0 2px var(--border);
        z-index: 1;
    }

    .points-timeline-dot {
        background: #4caf50;
        box-shadow: 0 0 0 2px #4caf50;
    }

    .points-timeline-content {
        background: var(--bg);
        border-radius: 12px;
        padding: 16px;
        transition: all 0.2s;
    }

    .points-timeline-content:hover {
        background: #e8eaf6;
    }

    .points-timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 8px;
    }

    .points-timeline-reason {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        flex: 1;
    }

    .points-timeline-value {
        font-size: 18px;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 8px;
    }

    .points-timeline-value {
        color: #2e7d32;
        background: #e8f5e9;
    }

    .points-timeline-meta {
        display: flex;
        gap: 16px;
        font-size: 12px;
        color: var(--text-sec);
    }

    .points-timeline-meta-item {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .points-empty {
        text-align: center;
        padding: 64px 24px;
        color: var(--text-light);
    }

    .points-empty-icon {
        font-size: 64px;
        margin-bottom: 16px;
        opacity: 0.5;
    }

    .points-empty-text {
        font-size: 16px;
        font-weight: 500;
    }

    .loading-spinner {
        text-align: center;
        padding: 48px;
    }

    .spinner {
        width: 48px;
        height: 48px;
        border: 4px solid var(--border-light);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 16px;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

<div class="points-container">
    <!-- Stats Grid -->
    <div class="points-stats-grid">
        <div class="points-stat-card">
            <div class="points-stat-header">
                <div class="points-stat-icon blue">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </svg>
                </div>
                <div>
                    <div class="points-stat-label">Điểm học kỳ hiện tại</div>
                </div>
            </div>
            <div class="points-stat-value" id="statDiemHocKy">0</div>
            <div class="points-stat-trend" id="statTenHocKy">Đang tải...</div>
        </div>

        <div class="points-stat-card">
            <div class="points-stat-header">
                <div class="points-stat-icon blue">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="8" r="7"/>
                        <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                    </svg>
                </div>
                <div>
                    <div class="points-stat-label">Xếp hạng</div>
                </div>
            </div>
            <div class="points-stat-value" id="statXepHang">-</div>
            <div class="points-stat-trend" id="statTongSV">Trong tất cả sinh viên</div>
        </div>

        <div class="points-stat-card">
            <div class="points-stat-header">
                <div class="points-stat-icon blue">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                    </svg>
                </div>
                <div>
                    <div class="points-stat-label">Số bài đã đăng</div>
                </div>
            </div>
            <div class="points-stat-value" id="statSoBai">0</div>
            <div class="points-stat-trend">Tài liệu đã chia sẻ</div>
        </div>
    </div>

    <!-- History -->
    <div class="points-history-card">
        <div class="points-history-header">
            <h2 class="points-history-title">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>Lịch sử cộng điểm</span>
            </h2>
            <div class="points-filter">
                <select class="points-filter-select" id="hocKyFilter" onchange="filterByHocKy()">
                    <option value="all">Tất cả học kỳ</option>
                </select>
            </div>
        </div>

        <div id="historyContainer">
            <div class="loading-spinner">
                <div class="spinner"></div>
                <div>Đang tải lịch sử...</div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/auth.js"></script>
<script>
    let allHistory = [];
    let allHocKy = [];
    let currentHocKy = 'all';

    document.addEventListener('DOMContentLoaded', function() {
        loadPointsData();
    });

    async function loadPointsData() {
        try {
            // Load stats
            const statsResponse = await fetch('/Points/GetPointsStats');
            const statsResult = await statsResponse.json();

            if (statsResult.success) {
                displayStats(statsResult);
            }

            // Load history
            const historyResponse = await fetch('/Points/GetPointsHistory');
            const historyResult = await historyResponse.json();

            if (historyResult.success) {
                allHistory = historyResult.lichSu || [];
                
                // Lấy danh sách học kỳ
                allHocKy = [...new Set(allHistory.map(item => item.hocKy).filter(hk => hk))];
                populateHocKyFilter();
                
                displayHistory(allHistory);
            }
        } catch (error) {
            console.error('Lỗi khi tải dữ liệu:', error);
            document.getElementById('historyContainer').innerHTML = `
                <div class="points-empty">
                    <div class="points-empty-icon">❌</div>
                    <div class="points-empty-text">Có lỗi xảy ra khi tải dữ liệu</div>
                </div>
            `;
        }
    }

    function populateHocKyFilter() {
        const select = document.getElementById('hocKyFilter');
        allHocKy.forEach(hk => {
            const option = document.createElement('option');
            option.value = hk;
            option.textContent = hk;
            select.appendChild(option);
        });
    }

    function displayStats(data) {
        // Stats
        document.getElementById('statDiemHocKy').textContent = data.diemHocKyHienTai.toLocaleString();
        document.getElementById('statTenHocKy').textContent = data.tenHocKyHienTai || 'Chưa có học kỳ';
        document.getElementById('statXepHang').textContent = data.xepHang;
        document.getElementById('statTongSV').textContent = `Trong ${data.tongSinhVien.toLocaleString()} sinh viên`;
        document.getElementById('statSoBai').textContent = data.soBaiDang.toLocaleString();
    }

    function displayHistory(history) {
        const container = document.getElementById('historyContainer');

        if (!history || history.length === 0) {
            container.innerHTML = `
                <div class="points-empty">
                    <div class="points-empty-icon">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity: 0.5;">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="15" y1="9" x2="9" y2="15"/>
                            <line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                    </div>
                    <div class="points-empty-text">Chưa có lịch sử cộng điểm</div>
                </div>
            `;
            return;
        }

        const html = `
            <div class="points-timeline">
                ${history.map(item => {
                    const diem = item.diemThayDoi || 0;
                    const date = item.ngayThayDoi ? new Date(item.ngayThayDoi).toLocaleDateString('vi-VN') : 'N/A';
                    
                    return `
                        <div class="points-timeline-item">
                            <div class="points-timeline-dot"></div>
                            <div class="points-timeline-content">
                                <div class="points-timeline-header">
                                    <div class="points-timeline-reason">${item.lyDo || 'Đăng tải tài liệu'}</div>
                                    <div class="points-timeline-value">
                                        +${diem}
                                    </div>
                                </div>
                                <div class="points-timeline-meta">
                                    <div class="points-timeline-meta-item">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10"/>
                                            <polyline points="12 6 12 12 16 14"/>
                                        </svg>
                                        <span>${date}</span>
                                    </div>
                                    ${item.hocKy ? `
                                        <div class="points-timeline-meta-item">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                                            </svg>
                                            <span>${item.hocKy}</span>
                                        </div>
                                    ` : ''}
                                    <div class="points-timeline-meta-item">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="12" y1="1" x2="12" y2="23"/>
                                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                        </svg>
                                        <span>Tổng: ${item.diemSauThayDoi || 0} điểm</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('')}
            </div>
        `;

        container.innerHTML = html;
    }

    function filterByHocKy() {
        const select = document.getElementById('hocKyFilter');
        const selectedHocKy = select.value;
        
        let filtered = allHistory;
        if (selectedHocKy !== 'all') {
            filtered = allHistory.filter(item => item.hocKy === selectedHocKy);
        }
        
        displayHistory(filtered);
    }
</script>
